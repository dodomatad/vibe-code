# ============================================================================
# Vibe Code v3.0.0 - Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# AI Provider API Keys
# ----------------------------------------------------------------------------

# Anthropic (Claude Sonnet 4, Claude Opus 4)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-5, o3-mini)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google (Gemini 2.5 Pro)
# Get your key at: https://ai.google.dev/
GOOGLE_API_KEY=...

# DeepSeek (DeepSeek V3) - Optional
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=...

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/vibecode

# ----------------------------------------------------------------------------
# Redis (for caching and rate limiting)
# ----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Billing (Stripe)
# ----------------------------------------------------------------------------

# Stripe API keys
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook secret (for handling webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs (create products in Stripe dashboard)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------

# Next.js
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Monitoring (Optional)
# ----------------------------------------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=...

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=...

# ----------------------------------------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------------------------------------

# Enable/disable features
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_MONITORING=false
